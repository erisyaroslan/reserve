rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile Photos
    match /profile-photos/{userId}/{allPaths=**} {
      allow read, write:
        if request.auth != null &&
           request.auth.uid == userId;
    }

    // Menu Images
    match /menu-images/{userId}/{allPaths=**} {
      allow read, write:
        if request.auth != null &&
           request.auth.uid == userId;
    }
  }
}